{
  "defaultProvider": "github-copilot",
  "defaultModel": "claude-sonnet-4.6",
  "defaultThinkingLevel": "medium",
  "packages": [
    {
      "source": "__DOTFILES_PI__",
      "skills": [
        "+pi/skills/excalidraw-diagram/SKILL.md",
        "+pi/skills/mermaid/SKILL.md",
        "+pi/skills/native-web-search/SKILL.md",
        "+pi/skills/uv/SKILL.md"
      ],
      "extensions": [
        "+pi/extensions/*.ts",
        "+pi/extensions/*/index.ts"
      ]
    },
    "npm:pi-powerline-footer",
    "npm:pi-hooks"
  ],
  "terminal": {
    "showTerminalProgress": true
  },
  "theme": "modern-dark",
  "images": {
    "blockImages": true
  },
  "editorPaddingX": 1,
  "compaction": {
    "enabled": true
  }
}
